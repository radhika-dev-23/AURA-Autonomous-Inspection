# ============================================================
# AURA — Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting caches
.mypy_cache/
.pyright/
.ruff_cache/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# FastAPI / Runtime
# -------------------------
*.log
logs/

# Temporary runtime files
tmp/
temp/
runtime/

# -------------------------
# Database
# -------------------------
*.db
*.sqlite
*.sqlite3

# SQLite temporary files
*.db-shm
*.db-wal

# -------------------------
# Generated Inspection Data
# -------------------------
data/generated/
data/runtime/
data/output/
data/cache/

# Generated image processing results
outputs/
artifacts/
generated/
processed/

# -------------------------
# Computer Vision Cache
# -------------------------
cv_cache/
image_cache/
heatmaps/
anomaly_maps/

# -------------------------
# Frontend
# -------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
.next/
.nuxt/
.vite/

# -------------------------
# IDE
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# Antigravity / local AI state
.antigravity/
.antigravity-local/
.agy/

# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -------------------------
# Python tooling
# -------------------------
.pyre/
.pytype/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Local scripts / machine files
# -------------------------
*.local
*.local.*